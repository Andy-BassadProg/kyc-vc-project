# Correspond a config.example.json du backend.
# Par defaut (valeurs ci-dessous) le front passe par le proxy Vite -> voir
# vite.config.ts, qui redirige vers le docker-compose du backend
# (wallet:7001, issuer:7002, verifier:7003). Laissez ces valeurs telles
# quelles pour le developpement local ; ne mettez une URL absolue
# (http://...) que si vous appelez les services directement (CORS requis
# cote service dans ce cas).
VITE_WALLET_BASE_URL=/api/wallet
VITE_ISSUER_BASE_URL=/api/issuer
VITE_VERIFIER_BASE_URL=/api/verifier
VITE_CREDENTIAL_TYPE=IdentityCredential
VITE_CREDENTIAL_CONFIGURATION_ID=IdentityCredential_jwt_vc_json
VITE_DEFAULT_AGENT_EMAIL=agence@test.local
