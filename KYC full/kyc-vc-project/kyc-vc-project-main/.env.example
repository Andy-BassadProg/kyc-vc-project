# Version des images waltid/*-api a utiliser (docker-compose.yml).
# "latest" fonctionne pour la demo ; en production, epinglez une version precise
# (ex. WALTID_VERSION=0.11.0) pour des builds reproductibles. Cf. tags disponibles :
# https://hub.docker.com/r/waltid/wallet-api/tags
WALTID_VERSION=latest
